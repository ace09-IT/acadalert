APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# AI Studio (Gemini) — the ONLY risk scoring path
# ============================================================
# There is no rule-based substitution: if the API is unreachable the run fails
# explicitly (HTTP 503) rather than inventing scores.
AI_STUDIO_API_KEY=
AI_STUDIO_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent
AI_STUDIO_TIMEOUT=1000
# Transport failures (HTTP error / timeout / empty body).
AI_STUDIO_RETRY_LIMIT=2
# Model-side omissions: re-ask a batch whose JSON array skipped students.
# 0 = fail on the first omission.
AI_STUDIO_BATCH_RETRY_LIMIT=2
# Per-request execution-time ceiling (seconds) for the long, synchronous AI
# endpoints (block risk scoring / block recommendation generation). A fresh PHP
# install defaults to max_execution_time=30s, which a 20-student block exceeds
# (4s batch pauses alone account for ~16s on Windows); the controllers raise it
# for that request only via set_time_limit(), so no php.ini edit is required.
# 0 disables the override and leaves the host default in place.
AI_STUDIO_MAX_EXECUTION_SECONDS=300

# ============================================================
# Mock API (json-server) — external data-ingestion layer
# ============================================================
# Raw data inputs (grades, attendance, attendance summaries/warnings, academic
# calendar, parents, school years, semesters, permissions, system settings) are
# read over HTTP instead of from the local database. The local database is kept
# strictly as the transactional persistence layer for post-computation
# aggregates (risk scores, intervention recommendations, flags, cases, reports).
#
# Two servers, both started WITHOUT `--watch` (json-server 0.17.x reloads the
# whole file after its own writes, which drops in-flight connections):
#
#   BULK (:3000, ~70 MB)  -> json-server db.bulk.json --port 3000   (read-only)
#   CORE (:3001, ~1.7 MB) -> json-server db.json --port 3001        (writable)
#
# (both files live in the `mockapi` folder that ships alongside this project,
#  e.g. C:\xampp\htdocs\Capstone2026\mockapi)
MOCK_API_BASE_URL=http://localhost:3000
MOCK_API_CORE_URL=http://localhost:3001
MOCK_API_TIMEOUT=15
MOCK_API_RETRY_TIMES=3
MOCK_API_RETRY_SLEEP_MS=150
# 0 = request-scoped memo only (no cross-request staleness window).
MOCK_API_CACHE_TTL_SECONDS=0
MOCK_API_CONCURRENCY=10
MOCK_API_ATTENDANCE_CHUNK=25
# Refuse every mirrored write when false (useful when running read-only drills).
MOCK_API_WRITES_ENABLED=true
